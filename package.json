{
  "name": "codevo-editor",
  "private": true,
  "version": "0.2.0-beta.129",
  "description": "Codevo is a desktop app for running Claude Code and Codex agents on your projects",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node ./scripts/check-initial-bundle-budget.mjs",
    "build:budget:test": "vitest run ./scripts/check-initial-bundle-budget.test.mjs",
    "check": "node ./scripts/check-version-sync.mjs && tsc --noEmit && npm run check -w @codevo/agent-events",
    "clippy:check": "node ./scripts/check-clippy-warning-budget.mjs",
    "lint": "eslint src packages vite.config.ts --max-warnings 0",
    "lint:exhaustive-deps": "node ./scripts/check-exhaustive-deps-budget.mjs",
    "lint:exhaustive-deps:update": "node ./scripts/check-exhaustive-deps-budget.mjs --update",
    "size:hotspots": "node ./scripts/check-hotspot-size-budget.mjs",
    "size:hotspots:update": "node ./scripts/check-hotspot-size-budget.mjs --update",
    "format": "prettier --write eslint.config.js .github/workflows/*.yml package.json vite.config.ts",
    "format:check": "prettier --check eslint.config.js .github/workflows/*.yml package.json vite.config.ts scripts/check-clippy-warning-budget.mjs scripts/check-changed-format.mjs scripts/check-changed-format.test.mjs scripts/release-quality-gates.test.mjs scripts/check-exhaustive-deps-budget.mjs scripts/check-exhaustive-deps-budget.test.mjs scripts/check-hotspot-size-budget.mjs scripts/check-hotspot-size-budget.test.mjs scripts/check-rust-format.mjs scripts/check-rust-format.test.mjs scripts/check-version-sync.mjs scripts/check-version-sync.test.mjs scripts/release-manifest-notes.test.mjs scripts/hotspot-size-baseline.json scripts/react-hooks-exhaustive-deps-baseline.json packages/agent-events/package.json packages/agent-events/tsconfig*.json",
    "format:check:changed": "node ./scripts/check-changed-format.mjs",
    "format:rust:check": "node ./scripts/check-rust-format.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "debug": "node ./scripts/debug-tauri.mjs",
    "debug:smoke": "node ./scripts/debug-tauri.mjs --smoke",
    "debug:tauri": "tauri dev",
    "debug:build": "tauri build --debug --no-bundle",
    "debug:bundle": "tauri build --debug",
    "smoke": "node ./scripts/qa-smoke.mjs",
    "smoke:fast": "node ./scripts/qa-smoke.mjs fast",
    "smoke:extended": "node ./scripts/qa-smoke.mjs extended",
    "smoke:full": "node ./scripts/qa-smoke.mjs full",
    "smoke:desktop": "node ./scripts/qa-smoke.mjs desktop",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/**/*.test.{ts,tsx}' --coverage.exclude='src/test/**' --coverage.thresholds.lines=45 --coverage.thresholds.functions=45 --coverage.thresholds.statements=45 --coverage.thresholds.branches=35 --coverage.include='packages/*/src/**/*.ts' --coverage.exclude='packages/*/src/**/*.test.ts'",
    "build:agent-events": "npm run build -w @codevo/agent-events"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.18.0",
    "marked": "^16.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "packages/*"
  ]
}
