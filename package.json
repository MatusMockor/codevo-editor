{
  "name": "codevo-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Codevo Editor is a Fleet-like PHP-focused desktop code editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "clippy:check": "node ./scripts/check-clippy-warning-budget.mjs",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "lint:exhaustive-deps": "node ./scripts/check-exhaustive-deps-budget.mjs",
    "lint:exhaustive-deps:update": "node ./scripts/check-exhaustive-deps-budget.mjs --update",
    "size:hotspots": "node ./scripts/check-hotspot-size-budget.mjs",
    "size:hotspots:update": "node ./scripts/check-hotspot-size-budget.mjs --update",
    "format": "prettier --write eslint.config.js .github/workflows/*.yml package.json vite.config.ts",
    "format:check": "prettier --check eslint.config.js .github/workflows/*.yml package.json vite.config.ts scripts/check-clippy-warning-budget.mjs scripts/check-changed-format.mjs scripts/check-exhaustive-deps-budget.mjs scripts/check-exhaustive-deps-budget.test.mjs scripts/check-hotspot-size-budget.mjs scripts/check-hotspot-size-budget.test.mjs scripts/check-rust-format.mjs scripts/check-rust-format.test.mjs scripts/hotspot-size-baseline.json scripts/react-hooks-exhaustive-deps-baseline.json",
    "format:check:changed": "node ./scripts/check-changed-format.mjs",
    "format:rust:check": "node ./scripts/check-rust-format.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "debug": "node ./scripts/debug-tauri.mjs",
    "debug:qa": "VITE_CODEVO_QA_BRIDGE=1 node ./scripts/debug-tauri.mjs",
    "debug:smoke": "node ./scripts/debug-tauri.mjs --smoke",
    "debug:tauri": "tauri dev",
    "debug:build": "tauri build --debug",
    "smoke": "node ./scripts/qa-smoke.mjs",
    "smoke:fast": "node ./scripts/qa-smoke.mjs fast",
    "smoke:extended": "node ./scripts/qa-smoke.mjs extended",
    "smoke:full": "node ./scripts/qa-smoke.mjs full",
    "smoke:desktop": "node ./scripts/qa-smoke.mjs desktop",
    "smoke:projects": "node ./scripts/qa-smoke.mjs projects",
    "qa:projects": "node ./scripts/qa-project-scenarios.mjs --all",
    "qa:projects:manual": "node ./scripts/qa-project-scenarios.mjs --all --manual",
    "qa:projects:preflight": "node ./scripts/qa-project-scenarios.mjs --all --preflight",
    "schemas:update:typescript": "node ./scripts/update-typescript-config-schemas.mjs",
    "schemas:check:typescript": "node ./scripts/update-typescript-config-schemas.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='src/**/*.test.{ts,tsx}' --coverage.exclude='src/test/**' --coverage.thresholds.lines=45 --coverage.thresholds.functions=45 --coverage.thresholds.statements=45 --coverage.thresholds.branches=35"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/monaco": "^4.2.0",
    "@shikijs/vscode-textmate": "^10.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@vue/typescript-plugin": "^3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.2",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^1.18.0",
    "marked": "^16.4.2",
    "monaco-editor": "^0.53.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0",
    "typescript-language-server": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
