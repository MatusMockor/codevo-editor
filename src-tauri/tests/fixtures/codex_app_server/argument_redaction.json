{
  "segmentMarkers": [
    "auth",
    "authorization",
    "bearer",
    "cookie",
    "credential",
    "credentials",
    "dsn",
    "jwt",
    "passphrase",
    "passwd",
    "password",
    "pwd",
    "secret",
    "token"
  ],
  "suffixMarkers": [
    "accesskey",
    "accesstoken",
    "apikey",
    "authtoken",
    "clientsecret",
    "connectionstring",
    "privatekey",
    "refreshtoken",
    "secretkey",
    "sessionid"
  ],
  "maxDepth": 8,
  "maxNodes": 256,
  "maxStringBytes": 1024,
  "cases": [
    {
      "name": "snake, kebab, dotted and camel keys",
      "input": {
        "team": "ENG",
        "api_key": "k1",
        "api-key": "k2",
        "api.key": "k3",
        "apiKey": "k4",
        "privateKey": "k5",
        "client_secret": "k6",
        "sessionId": "k7",
        "X-Access-Key": "k8",
        "Passphrase": "k9",
        "pwd": "k10",
        "JWT": "k11",
        "dsn": "k12",
        "connectionString": "k13"
      },
      "expected": {
        "team": "ENG",
        "api_key": "[redacted]",
        "api-key": "[redacted]",
        "api.key": "[redacted]",
        "apiKey": "[redacted]",
        "privateKey": "[redacted]",
        "client_secret": "[redacted]",
        "sessionId": "[redacted]",
        "X-Access-Key": "[redacted]",
        "Passphrase": "[redacted]",
        "pwd": "[redacted]",
        "JWT": "[redacted]",
        "dsn": "[redacted]",
        "connectionString": "[redacted]"
      }
    },
    {
      "name": "segment and suffix key matching",
      "input": {
        "max_tokens": 1,
        "tokenCount": 2,
        "author": "a",
        "authority": "b",
        "auth": "c",
        "authorization": "d",
        "token": "e",
        "accessToken": "f",
        "x-api-key": "g",
        "password": "h",
        "dbPassword": "i",
        "passphrase": "j",
        "pwd": "k",
        "SECRET_KEY": "l",
        "refresh_token": "m",
        "APIKey": "n",
        "OAuthToken": "o",
        "keyboard": "p",
        "monkey": "q"
      },
      "expected": {
        "max_tokens": 1,
        "tokenCount": 2,
        "author": "a",
        "authority": "b",
        "auth": "[redacted]",
        "authorization": "[redacted]",
        "token": "[redacted]",
        "accessToken": "[redacted]",
        "x-api-key": "[redacted]",
        "password": "[redacted]",
        "dbPassword": "[redacted]",
        "passphrase": "[redacted]",
        "pwd": "[redacted]",
        "SECRET_KEY": "[redacted]",
        "refresh_token": "[redacted]",
        "APIKey": "[redacted]",
        "OAuthToken": "[redacted]",
        "keyboard": "p",
        "monkey": "q"
      }
    },
    {
      "name": "header pairs use the same key rules",
      "input": [
        {
          "name": "Author",
          "value": "v1"
        },
        {
          "name": "Set-Cookie",
          "value": "v2"
        },
        {
          "header": "max_tokens",
          "value": "v3"
        }
      ],
      "expected": [
        {
          "name": "Author",
          "value": "v1"
        },
        {
          "name": "Set-Cookie",
          "value": "[redacted]"
        },
        {
          "header": "max_tokens",
          "value": "v3"
        }
      ]
    },
    {
      "name": "secret keys redact whole nested values",
      "input": {
        "credentials": {
          "user": "u",
          "list": [1, 2]
        },
        "authHeader": ["x"]
      },
      "expected": {
        "credentials": "[redacted]",
        "authHeader": ["x"]
      }
    },
    {
      "name": "header name/value pairs",
      "input": {
        "headers": [
          {
            "name": "Authorization",
            "value": "opaque-1"
          },
          {
            "key": "X-Api-Key",
            "value": "opaque-2"
          },
          {
            "header": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "cookie",
            "value": "sid=1"
          }
        ]
      },
      "expected": {
        "headers": [
          {
            "name": "Authorization",
            "value": "[redacted]"
          },
          {
            "key": "X-Api-Key",
            "value": "[redacted]"
          },
          {
            "header": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "cookie",
            "value": "[redacted]"
          }
        ]
      }
    },
    {
      "name": "credentials inside URLs",
      "input": {
        "url": "postgres://admin:s3cr%21t@db.internal:5432/app",
        "plain": "https://example.com:8080/path@anchor",
        "empty_user": "redis://:hunter2@cache:6379",
        "text": "clone https://me:ghp_abc@github.com/o/r.git now"
      },
      "expected": {
        "url": "postgres://admin:[redacted]@db.internal:5432/app",
        "plain": "https://example.com:8080/path@anchor",
        "empty_user": "redis://:[redacted]@cache:6379",
        "text": "clone https://me:[redacted]@github.com/o/r.git now"
      }
    },
    {
      "name": "bearer and basic tokens inside strings",
      "input": {
        "h": "Bearer eyJhbGciOi.J9.abc",
        "b": "basic dXNlcjpwYXNz",
        "prose": "Basic idea stays",
        "short": "Bearer abc",
        "exact": "Bearer 12345678"
      },
      "expected": {
        "h": "Bearer [redacted]",
        "b": "basic [redacted]",
        "prose": "Basic idea stays",
        "short": "Bearer abc",
        "exact": "Bearer [redacted]"
      }
    },
    {
      "name": "nested arrays",
      "input": [
        [
          {
            "token": "t"
          }
        ],
        [["Bearer abcdefgh12"]],
        {
          "items": [
            {
              "password": "p",
              "keep": true
            }
          ]
        }
